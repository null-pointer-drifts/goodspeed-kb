# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose this on the frontend

# AI provider — see README for full list of supported providers
AI_PROVIDER=openai                                 # openai | groq | together | openrouter | ollama
AI_API_KEY=sk-...                                  # API key for your chosen provider
AI_BASE_URL=https://api.openai.com/v1              # Base URL for your chosen provider
AI_MODEL=gpt-4o-mini                               # Chat model
AI_EMBEDDING_MODEL=text-embedding-3-small          # Embedding model (must produce 1536-dim vectors)

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
